# Copy this file to .env and fill in real values.

# Anthropic API key for Claude-powered agenda summarization.
# Get one at https://console.anthropic.com/
ANTHROPIC_API_KEY=your_api_key_here

# BPN Postgres connection string — used by bpn_upcoming_events.py to pull
# upcoming ZBA hearings and sheriff sales directly from BPN's pipeline
# database. Use the same value as the BPN pipeline's .env.local.
# Format: postgresql://<user>:<password>@<host>/<db>
BPN_POSTGRES=postgresql://user:password@host/database
